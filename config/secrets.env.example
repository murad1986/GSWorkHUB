# Секреты склада. Скопировать в config/secrets.env и заполнить своими
# значениями. Файл с настоящими ключами в git не попадает — см. .gitignore.
# На сервере те же имена заводятся переменными окружения в панели хостинга.

# Разговорный вход через Telegram: токен бота от @BotFather и числовой id
# того, чьи сообщения бот принимает. Чужие сообщения бот игнорирует.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Расшифровка голоса — deepgram.com, ключ проекта.
DEEPGRAM_API_KEY=

# Задачи TickTick. Для первой авторизации нужны client_id и client_secret
# из dida365.com/manage; дальше файл заполняется сам.
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
TICKTICK_ACCESS_TOKEN=
TICKTICK_REFRESH_TOKEN=
TICKTICK_EXPIRES_AT=

# Встречи Granola — ключ берётся из локального приложения на macOS.
GRANOLA_API_KEY=
